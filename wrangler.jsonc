// FPL Manager sa SquadJury dodatkom: jedan Worker, statične stranice iz public/.
// SquadJury koristi D1 bazu, R2 za slike i cron (zaključavanje kola, bodovi, značke, kopije baze).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Ime je "squadjury": ide na postojeći Worker (ista baza, tajne i domena), Manager je na /, SquadJury na /jury.
	"name": "squadjury",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/jury", "/jury/*", "/t/*", "/u/*", "/r/*", "/l/*", "/embed/*", "/leaderboard*", "/post*", "/squad*", "/me", "/me/*", "/how", "/rules", "/privacy", "/admin", "/login"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "squadjury",
			"database_id": "51c7e7f2-dd20-47d7-b0b6-dbabbad7844f",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "squadjury-images"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *", "0 * * * *", "17 4 * * 1"]
	},
	// ADMIN_EMAILS, ADMIN_TOKEN i RESEND_API_KEY su tajne (npx wrangler secret put ...), nisu u repou.
	"vars": {
		// "live" čita pravi FPL API (Manager i SquadJury); lokalno se koristi snapshot (vidi npm run dev)
		"FPL_SOURCE": "live",
		// javni Google OAuth client id (nije tajna)
		"GOOGLE_CLIENT_ID": "897611394397-qvujljt62q2coact1p0rdtua0egtv3p4.apps.googleusercontent.com"
	},
	"observability": { "enabled": true }
}
