// Cloudflare Worker config for SquadJury.
// Before the first production deploy, replace the D1 database_id (see README, "Deploy").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squadjury",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/t/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squadjury",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "squadjury-images" }],
  "triggers": { "crons": ["*/5 * * * *", "0 * * * *"] },
  "vars": {
    // Public OAuth client id from Google Cloud (not a secret).
    "GOOGLE_CLIENT_ID": "",
    // Comma separated Google emails that can open /admin.
    "ADMIN_EMAILS": ""
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
