{
  "name": "squadjury",
  "version": "0.1.0",
  "private": true,
  "description": "Post your FPL squad. The jury decides.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --var DEV_LOGIN:1 --var FPL_SOURCE:snapshot",
    "db:migrate": "wrangler d1 migrations apply squadjury --local",
    "seed": "node scripts/seed.mjs",
    "vendor": "node scripts/vendor.mjs",
    "snapshot": "node scripts/build-snapshot.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:ocr": "node --test tests/ocr/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "deploy": "wrangler deploy",
    "db:reset": "rm -rf .wrangler/state && wrangler d1 migrations apply squadjury --local",
    "icons": "node scripts/icons.mjs",
    "logo": "python3 scripts/logo.py && node scripts/icons.mjs"
  },
  "author": "Ahmed Grabus (grabator)",
  "license": "UNLICENSED",
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jpeg-js": "^0.4.4",
    "playwright-core": "1.56",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^5.1.1"
  }
}
