{
  "name": "fpl-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor.mjs",
    "dev": "wrangler dev --local --port 8790 --var FPL_SOURCE:snapshot --var DEV_LOGIN:1 --var ADMIN_EMAILS:admin@example.test",
    "db:migrate": "wrangler d1 migrations apply squadjury --local",
    "seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "vendor": "node scripts/vendor.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply squadjury --remote",
    "deploy": "node scripts/vendor.mjs && wrangler deploy",
    "test": "node --test tests/*.test.mjs tests/jury/unit/*.test.mjs",
    "test:api": "node tests/jury/api/run.mjs",
    "points": "node scripts/points.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jpeg-js": "^0.4.4",
    "playwright-core": "1.56",
    "wrangler": "^4.149.0"
  },
  "description": "FPL Manager sa SquadJury dodatkom: tvoj FPL tim, savjeti i ocjenjivanje timova.",
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "qrcode-generator": "^2.0.4",
    "tesseract.js": "^5.1.1"
  }
}
